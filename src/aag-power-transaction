#!/usr/bin/python3
"""Reference power transaction dispatcher; ordinary Suspend remains v1.3.1."""
import sys
sys.dont_write_bytecode = True
sys.path.insert(0, '/usr/local/lib/aag-sleep-transaction')
from aag_safe_suspend.power_dispatch import main

try:
    raise SystemExit(main())
except Exception as exc:
    print('POWER_TRANSACTION_REFUSED '+str(exc), file=sys.stderr, flush=True)
    raise SystemExit(1)
