#!/usr/bin/python3
from pathlib import Path
import os
import sys

root = Path(os.environ.get("AAG_SAFE_SUSPEND_ROOT", "/"))
installed = root / "usr/lib/aag-external-storage-safe-suspend"
source = Path(__file__).resolve().parent
sys.path.insert(0, str(installed if installed.is_dir() else source))

from aag_safe_suspend.job_guard import main

raise SystemExit(main())
